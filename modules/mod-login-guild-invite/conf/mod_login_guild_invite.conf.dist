[worldserver]

###################################################################################################
# LOGIN GUILD INVITE
#
#    角色升级到指定等级（Level）时，若尚未加入任何公会，则由系统向其发送加入「指定公会」的邀请。
#    由于角色等级只会上升、不会下降，每个角色只会经过一次目标等级，因此每个角色仅触发一次。
#    玩家在客户端确认后才会真正入会；拒绝则维持现状。
#
#    LoginGuildInvite.Enable
#        Description: 是否启用「上线自动公会邀请」功能。
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

LoginGuildInvite.Enable = 0

#
#    LoginGuildInvite.GuildId
#        Description: 目标公会的 ID（characters 库 guild 表的 guildid）。
#                     该值优先于 GuildName；为 0 时改用 GuildName 按名称匹配。
#        Default:     0 - (Disabled)

LoginGuildInvite.GuildId = 0

#
#    LoginGuildInvite.GuildName
#        Description: 目标公会的名称，仅在 GuildId 为 0 时生效。
#        Default:     "" - (Disabled)

LoginGuildInvite.GuildName = ""

#
#    LoginGuildInvite.Level
#        Description: 触发邀请的角色等级，角色升级到该等级时发送邀请。
#                     由于等级只升不降，每个角色只会经过一次该等级，因此仅触发一次。
#        Default:     35

LoginGuildInvite.Level = 35
