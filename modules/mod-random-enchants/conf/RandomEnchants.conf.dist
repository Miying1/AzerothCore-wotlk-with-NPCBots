[worldserver]
#
###################################################################################################

###################################################################################################
#
# RANDOM ENCHANTS OPTIONS
#
#     RandomEnchants.Enable
#        Enable or disable the module
#        Default:     1 (enabled)

RandomEnchants.Enable = 1

#
#     RandomEnchants.OnLoot
#        Chance at random enchant on looting an item
#        Default:     1

RandomEnchants.OnLoot=1

#
#     RandomEnchants.OnCreate
#        Chance at random enchant on creating an item via profession
#        Default:     1

RandomEnchants.OnCreate=1
 

#
#     RandomEnchants.OnGroupRoll 
#        Chance at random enchant on obtaining item from group rolls
#        Default:     1

RandomEnchants.OnGroupRoll = 1

#     RandomEnchants.LootEnchantChance1
#        Probability (in percentage) for the first enchant to be applied.
#        Default:     70.0

RandomEnchants.LootEnchantChance1=30.0
#重新FM成功率
RandomEnchants.ReRandChance=75.0
#随机FM值的范围%
RandomEnchants.RandRangeattrMaxPct=0.50
 
#最高等级属性洗练成功率
RandomEnchants.MaxAttrChance=20.0

#
#     自定义装备段四分组随机附魔（item_random_enchant.cpp）
#
#     附魔时机与上方 RandomEnchants.OnLoot / OnCreate / OnGroupRoll 共用：
#     拾取 / 制造 / 团队 roll 获得装备时触发，三个开关任一关闭即该时机不附魔。
#
#     RandomEnchants.Custom.Enable
#        是否启用该四分组方案（法系/物理/防御/治疗）
#        Default:     1 (enabled)
RandomEnchants.Custom.Enable = 1

#     RandomEnchants.Custom.Chance
#        装备等级超过 MinItemLevel 时，触发随机附魔的概率（百分比）
#        Default:     100.0
RandomEnchants.Custom.Chance = 70.0

#     RandomEnchants.Custom.MinItemLevel
#        触发附魔的最低装备等级（严格大于该值）
#        Default:     220
RandomEnchants.Custom.MinItemLevel = 220

#     RandomEnchants.Custom.WeightMinLevel
#        权重偏好下限：装备等级 <= 该值时，低数值档位权重最大
#        Default:     220
RandomEnchants.Custom.WeightMinLevel = 230

#     RandomEnchants.Custom.WeightMaxLevel
#        权重偏好上限：装备等级 >= 该值时，高数值档位权重最大
#        装备等级在 [WeightMinLevel, WeightMaxLevel] 之间线性过渡
#        Default:     284
RandomEnchants.Custom.WeightMaxLevel = 260

#     RandomEnchants.Custom.LowTierBias
#        低数值偏好强度（指数，>= 1.0）
#        对低装等基准权重取幂，指数越大，低等级装备越集中在低数值档位
#        1.0 = 原始线性权重；2.0 = 低等级装备抽到低级属性的权重明显提高
#        Default:     2.0
RandomEnchants.Custom.LowTierBias = 2.0